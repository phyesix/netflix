# Not: docker env_file satır sonu yorumlarını desteklemez, yorumlar ayrı satırda.

# ---------- Netflix Top 10 ----------
# ISO2 ülke kodu
NETFLIX_COUNTRY=TR
# Son kaç haftanın listesine bakılsın
TOP10_WEEKS=1
# Sadece ilk N sıra (ör. 5)
TOP10_MAX_RANK=10
# Eklenmeyecek başlıklar, virgülle ayrılmış
EXCLUDE_TITLES=

# ---------- Zamanlama (dahili cron) ----------
# Standart 5 alanlı cron: dakika saat gün ay haftanın-günü
# Varsayılan: 6 saatte bir, dakika 17'de. Örnekler:
#   "0 12 * * *"   her gün 12:00
#   "30 10 * * 2"  her salı 10:30 (Netflix listeyi salı günü günceller)
CRON_SCHEDULE=17 */6 * * *
TZ=Europe/Istanbul
# Konteyner açılınca cron'u beklemeden hemen bir kez çalışsın
RUN_ON_START=true
# true: hiçbir şey eklemeden sadece ne yapacağını logla
DRY_RUN=false

# ---------- Sonarr (diziler) ----------
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
# İsim veya ID; boşsa ilk profil
SONARR_QUALITY_PROFILE=
# Ör. /tv; boşsa ilk root folder
SONARR_ROOT_FOLDER=
# all | future | missing | existing | firstSeason | latestSeason | pilot | none
SONARR_MONITOR=all
SONARR_SEARCH=true
SONARR_TAGS=netflix-top10-tr
# Sadece Sonarr v3 için; v4'te gerekmez
SONARR_LANGUAGE_PROFILE=

# ---------- Radarr (filmler) ----------
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_QUALITY_PROFILE=
# Ör. /movies
RADARR_ROOT_FOLDER=
# announced | inCinemas | released
RADARR_MINIMUM_AVAILABILITY=released
RADARR_SEARCH=true
RADARR_TAGS=netflix-top10-tr

LOG_LEVEL=INFO
